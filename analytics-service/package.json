{
  "name": "analytics-service",
  "version": "1.0.0",
  "description": "URL Shortener - Analytics Microservice (Kafka Consumer + Cassandra + gRPC)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "ts-node src/db/migrations.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@grpc/proto-loader": "^0.7.0",
    "cassandra-driver": "^4.7.0",
    "dotenv": "^16.3.0",
    "kafkajs": "^2.2.0",
    "ua-parser-js": "^1.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ua-parser-js": "^0.7.0",
    "@types/uuid": "^9.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  }
}
